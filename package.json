{
  "name": "nexuscore-api",
  "version": "1.0.0",
  "description": "API REST con autenticación JWT, roles y TDD",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPatterns=tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "test:e2e": "docker-compose -f docker-compose.test.yml up -d && npx prisma migrate deploy && jest --testMatch='**/*.e2e.test.ts' --runInBand && docker-compose -f docker-compose.test.yml down",
    "test:e2e:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:e2e:down": "docker-compose -f docker-compose.test.yml down",
    "test:e2e:logs": "docker-compose -f docker-compose.test.yml logs -f",
    "db:test:deploy": "npx prisma migrate deploy",
    "db:test:reset": "npx prisma migrate reset --force",
    "db:test:studio": "npx prisma studio --port 5556",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "docker:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:restart": "docker-compose -f docker-compose.prod.yml restart",
    "docker:clean": "docker-compose -f docker-compose.prod.yml down -v --rmi all"
  },
  "keywords": [
    "api",
    "rest",
    "typescript",
    "tdd",
    "nodejs"
  ],
  "author": "Sebastian Diaz",
  "license": "MIT",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sebast27/NexusCore-API.git"
  },
  "bugs": {
    "url": "https://github.com/Sebast27/NexusCore-API/issues"
  },
  "homepage": "https://github.com/Sebast27/NexusCore-API#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
